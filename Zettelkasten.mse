	(FAMIX.Comment (id: 97930)
		(container (ref: 11898))
		(content '/** 
 * A string array that contains the different encodings that are used by the different reference- managers when exporting their data to a bibtext file. use also  {@link #BIBTEX_DESCRIPTIONS} to retrieve the programmes'' namesassociated with these encoding.<br> <br> 0: UTF-8 (Bibliographix)<br> 1: UTF-8 (BibDesk)<br> 2: UTF-8 (Citavi)<br> 3: ISO8859_1 (Emacs with AucTex/RefTex)<br> 4: UTF-8 (Endnote)<br> 5: ISO8859_1 (JabRef)<br> 6: UTF-8 (JabRef)<br> 7: UTF-8 (Mendeley)<br> 8: UTF-8 (Refworks)<br> 9: UTF-8 (Zotero)<br>
 */
'))
