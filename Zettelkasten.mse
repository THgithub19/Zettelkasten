		(signature 'jTableBookmarks.addMouseListener(new MouseAdapter(){
  @Override public void mousePressed(  MouseEvent evt){
    if (evt.isPopupTrigger() && !jPopupMenuBookmarks.isVisible()) {
      jPopupMenuBookmarks.show(jTableBookmarks,evt.getPoint().x,evt.getPoint().y);
    }
  }
  @Override public void mouseReleased(  MouseEvent evt){
    if (evt.isPopupTrigger() && !jPopupMenuBookmarks.isVisible()) {
      jPopupMenuBookmarks.show(jTableBookmarks,evt.getPoint().x,evt.getPoint().y);
    }
  }
  @Override public void mouseClicked(  MouseEvent evt){
    if (evt.getButton() != MouseEvent.BUTTON1) {
      return;
    }
    if (evt.getClickCount() == 2) {
      setNewActivatedEntryAndUpdateDisplay(ZettelkastenViewUtil.retrieveSelectedEntryFromTable(data,jTableBookmarks,0));
    }
  }
}
