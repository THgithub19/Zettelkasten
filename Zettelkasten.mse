      jPopupMenuCCP.show(jTextFieldFind,evt.getPoint().x,evt.getPoint().y);
    }
  }
  @Override public void mouseReleased(  java.awt.event.MouseEvent evt){
    if (evt.isPopupTrigger() && !jPopupMenuCCP.isVisible()) {
      jPopupMenuCCP.show(jTextFieldFind,evt.getPoint().x,evt.getPoint().y);
    }
  }
