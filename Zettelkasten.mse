    if (row >= tm.getRowCount()) {
      row--;
    }
    jTableAutoKorrektur.setColumnSelectionInterval(col,col);
    jTableAutoKorrektur.setRowSelectionInterval(row,row);
    jButtonApply.setEnabled(true);
  }
}'))
